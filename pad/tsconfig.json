      "@lezer/common": ["../../deps/common/src/index.ts"],
      "@lezer/highlight": ["../../deps/highlight/src/highlight.ts"],
      "@lezer/lr": ["../../deps/lr/src/index.ts"],
      "@marijn/find-cluster-break": ["../../deps/find-cluster-break/src/index.d.ts"],
      "style-mod": ["../../deps/style-mod/src/style-mod.d.ts"],
